# ============================================================================
# G&G Manpower & Professional Services — Deployment Environment Template
# Copy this file to `.env` for local development or configure these variables
# in your cloud hosting dashboard (Railway, Render, VPS, or Docker).
# ============================================================================

# 1. PostgreSQL Database Connection (Neon / Vercel Marketplace)
# On Vercel, adding the Neon integration sets both of these automatically.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# 2. Session & Authentication Security (minimum 32 characters in production)
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"

# 3. Public Application Base URL (used in SMS {{portal_link}} URLs)
APP_URL="http://localhost:3000"

# ============================================================================
# 4. Philippine SMS Gateway Configuration
# Supported SMS_PROVIDER values:
#   - "mock"      : Default simulated mode (no real SMS sent; logs to console)
#   - "semaphore" : Semaphore SMS Philippines (https://semaphore.co)
#   - "philsms"   : PhilSMS Philippines (https://philsms.com)
#   - "iprog"     : IPROG Tech SMS Philippines (https://sms.iprogtech.com)
#   - "textbee"   : TextBee Android SIM Gateway (https://textbee.dev — Free using your own PH SIM)
#   - "generic"   : Custom HTTP POST JSON endpoint via SMS_PROVIDER_URL
# ============================================================================
SMS_PROVIDER=""
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID=""

# Optional: Only required when SMS_PROVIDER="textbee" (Android phone SIM gateway)
TEXTBEE_DEVICE_ID=""

# Optional: Custom endpoint override (auto-configured for semaphore/philsms/iprog/textbee)
SMS_PROVIDER_URL=""
SMS_FROM_NUMBER="+639170000000"
SMS_MAX_ATTEMPTS="3"

# 5. Webhook & Queue Processing Secrets
SMS_WEBHOOK_SECRET="replace-with-webhook-secret"
CRON_SECRET="replace-with-cron-secret"

